API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
WEB_ORIGINS=http://192.168.148.1:5173
SUPABASE_URL=https://your-project.supabase.co
# Public publishable/anon key used for authenticated recruiter requests.
SUPABASE_ANON_KEY=your-public-anon-key
# Server-only. Required by the durable resume screening worker; never use in apps/web.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GITHUB_TOKEN=
# Optional dedicated GitHub token for contribution calendar queries. Configure without read:user.
GITHUB_PUBLIC_CONTRIBUTIONS_TOKEN=
# Backend-only alfa-leetcode-api service URL. Override with a local URL only when running it locally.
LEETCODE_API_BASE_URL=https://alfa-leetcode-api.onrender.com
# Backend-only Groq credential. Leave blank to keep AI analysis disabled.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_MS=12000
# Google Drive OAuth (backend only; leave blank until Google Cloud is configured).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/google-drive/callback
# Generate independent random values; state secret >=32 chars, encryption key = base64 of 32 random bytes.
GOOGLE_DRIVE_STATE_SECRET=
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
