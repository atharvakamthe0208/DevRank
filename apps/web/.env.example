# Same-origin path; Vite proxies /api to the local API during development.
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=https://your-project.supabase.co
# Public browser key only. Legacy VITE_SUPABASE_ANON_KEY is also supported.
# Never place a Supabase secret/service-role key in a VITE_* variable.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
